// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "group/status",
        "power-profiles-daemon",
        "custom/power"
    ],

    // ---------- Groups (each renders as one pill) ----------
    "group/status": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "network", "bluetooth", "battery"]
    },

    // ---------- Left ----------
    "hyprland/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": { "*": 5 }
    },
    "hyprland/submap": {
        "format": "  {}"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },

    // ---------- Center ----------
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months":   "<span color='#cdd6f4'><b>{}</b></span>",
                "weekdays": "<span color='#7f849c'>{}</span>",
                "days":     "<span color='#bac2de'>{}</span>",
                "today":    "<span background='#89dceb' color='#11111b'><b>{}</b></span>"
            }
        }
    },

    // ---------- Right ----------
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Idle inhibitor: on",
        "tooltip-format-deactivated": "Idle inhibitor: off"
    },
    "network": {
        "interface": "wlp3s0",
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰤫",
        "format-disconnected": "󰤮",
        "format-disabled": "󰤮",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Wi-Fi disconnected (click to connect)",
        "tooltip-format-disabled": "Wi-Fi off (right-click to turn on)",
        "on-click": "pidof -x networkmanager_dmenu || networkmanager_dmenu",
        "on-click-right": "nmcli radio wifi $(nmcli radio wifi | grep -q enabled && echo off || echo on)"
    },
    "bluetooth": {
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "max-length": 24,
        "tooltip-format": "{controller_alias}  {status}",
        "tooltip-format-off": "Bluetooth off (right-click to turn on)",
        "tooltip-format-disabled": "Bluetooth off (right-click to turn on)",
        "tooltip-format-connected": "{controller_alias}  {num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "on-click": "pidof overskride || overskride",
        "on-click-right": "~/.config/waybar/scripts/bluetooth-toggle.sh"
    },
    "battery": {
        "bat": "BAT0",
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
            "default": "",
            "performance": "󰓅",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        // Left click: full-screen wlogout power menu (same as Super+Escape)
        "on-click": "pidof wlogout || wlogout -b 4 -T 260 -B 260 -L 200 -R 200",
        // Right click: the old compact dropdown
        "menu": "on-click-right",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "loginctl lock-session",
            "logout": "hyprctl dispatch 'hl.dsp.exit()'",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
