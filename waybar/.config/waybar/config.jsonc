// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "group/status",
        "power-profiles-daemon",
        "custom/power"
    ],

    // ---------- Groups (each renders as one pill) ----------
    "group/status": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "battery"]
    },

    // ---------- Left ----------
    "hyprland/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": { "*": 5 }
    },
    "hyprland/submap": {
        "format": "  {}"
    },

    // ---------- Center ----------
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M}",
        // Keep at 60: the clock re-sets its calendar tooltip on every tick, and in
        // GTK3 that re-queries tooltips bar-wide, resetting every module's hover
        // delay. interval 1 made tooltips randomly fail to appear.
        "interval": 60,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months":   "<span color='#cdd6f4'><b>{}</b></span>",
                "weekdays": "<span color='#7f849c'>{}</span>",
                "days":     "<span color='#bac2de'>{}</span>",
                "today":    "<span background='#89dceb' color='#11111b'><b>{}</b></span>"
            }
        }
    },

    // ---------- Right ----------
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Idle inhibitor: on",
        "tooltip-format-deactivated": "Idle inhibitor: off"
    },
    "battery": {
        "bat": "BAT0",
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
            "default": "",
            "performance": "󰓅",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        // Left click: full-screen wlogout power menu (same as Super+Escape)
        "on-click": "pidof wlogout || wlogout -b 4 -T 260 -B 260 -L 200 -R 200",
        // Right click: the old compact dropdown
        "menu": "on-click-right",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "loginctl lock-session",
            "logout": "hyprctl dispatch 'hl.dsp.exit()'",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
